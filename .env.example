# --- Local dev (Ollama + Gemma) ---
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# --- Cloud deploy (Render free + Groq free API — recommended) ---
# Get key: https://console.groq.com/keys
# Set in Render dashboard only — never commit real keys.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_JUDGE_MODEL=llama-3.3-70b-versatile

# --- Optional cloud fallback (Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- SQLite orders database ---
ORDERS_DB_PATH=data/orders.db
